# Keep the AeroSpace key combinations. skhd handles shortcuts for yabai.
:: service @

# Focus and swap windows.
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east
alt + shift - h : yabai -m window --swap west
alt + shift - j : yabai -m window --swap south
alt + shift - k : yabai -m window --swap north
alt + shift - l : yabai -m window --swap east

# Resize from either side of the BSP split.
alt + ctrl - h : yabai -m window --resize right:-50:0 || yabai -m window --resize left:50:0
alt + ctrl - l : yabai -m window --resize right:50:0 || yabai -m window --resize left:-50:0
alt + ctrl - k : yabai -m window --resize bottom:0:-50 || yabai -m window --resize top:0:50
alt + ctrl - j : yabai -m window --resize bottom:0:50 || yabai -m window --resize top:0:-50

# Layout and fullscreen.
alt - 0x2C : yabai -m space --rotate 90
alt - 0x2B : ~/.config/yabai/scripts/toggle-layout stack
alt + shift - space : yabai -m window --toggle float
alt - f : yabai -m window --toggle zoom-fullscreen

# Native macOS Spaces 1-9.
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9
alt + shift - 1 : yabai -m window --space 1 && yabai -m space --focus 1
alt + shift - 2 : yabai -m window --space 2 && yabai -m space --focus 2
alt + shift - 3 : yabai -m window --space 3 && yabai -m space --focus 3
alt + shift - 4 : yabai -m window --space 4 && yabai -m space --focus 4
alt + shift - 5 : yabai -m window --space 5 && yabai -m space --focus 5
alt + shift - 6 : yabai -m window --space 6 && yabai -m space --focus 6
alt + shift - 7 : yabai -m window --space 7 && yabai -m space --focus 7
alt + shift - 8 : yabai -m window --space 8 && yabai -m space --focus 8
alt + shift - 9 : yabai -m window --space 9 && yabai -m space --focus 9

# Service mode (semicolon has macOS keycode 0x29).
alt + shift - 0x29 ; service
service < escape ; default
service < r : yabai -m space --balance
service < f : yabai -m window --toggle float
service < backspace : ~/.config/yabai/scripts/close-other-windows
service < alt + shift - h : yabai -m window --warp west
service < alt + shift - j : yabai -m window --warp south
service < alt + shift - k : yabai -m window --warp north
service < alt + shift - l : yabai -m window --warp east
