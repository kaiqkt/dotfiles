--tmux 90%,90%
--multi
--bind='ctrl-o:become($EDITOR {})'
--bind 'ctrl-/:toggle-preview'
--bind 'ctrl-d:preview-half-page-down'
--bind 'ctrl-u:preview-half-page-up'
--preview 'fzf-preview.sh {}'
--padding=0% --color='dark,fg:magenta'
--layout=reverse
--border-label=''
--info=hidden
--prompt='▶ '
--pointer='▶'
--marker=''
--padding 0,1
--margin 0,0
--border
--style=full
--no-scrollbar
--bind 'focus:transform-preview-label:[[ -n {} ]] && printf \" %s \" {}'
--color=dark
--color 'border:#4e6e94,label:#3a85bb'
--color 'input-border:#3a85bb,input-label:#b8333c'
--color 'preview-border:#3a85bb,preview-label:#b8333c'
--color 'list-border:#3a85bb,list-label:#b8333c'
--color 'gutter:#254664'
--color 'current-bg:#254664'
--color 'current-hl:#adb833'
--color 'list-fg:#86adce'
--color 'pointer:#adb833'
--color 'marker:#adb833'