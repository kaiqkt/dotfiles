#!/usr/bin/env python3
"""Adapt Matugen's Material You roles to our dark Base16 application themes."""

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

DOTFILES = Path(__file__).resolve().parent.parent
SCHEME_FILE = (Path.home() / "Library/Application Support/flavours/base16/schemes"
               / "wallpaper/wallpaper.yaml")
SEMANTIC_COLORS = ("red", "orange", "yellow", "green", "cyan", "blue", "magenta")
NEUTRAL_ROLES = (
    "surface_container_low", "surface_container_high", "surface_container_highest",
    "outline", "on_surface_variant", "on_surface",
)


def run(command, **kwargs):
    try:
        return subprocess.run(command, check=True, text=True, timeout=120, **kwargs)
    except FileNotFoundError as error:
        raise RuntimeError(f"Required command not found: {command[0]}") from error
    except subprocess.TimeoutExpired as error:
        raise RuntimeError(f"Command timed out: {command[0]}") from error
    except subprocess.CalledProcessError as error:
        raise RuntimeError(f"{command[0]} failed: {(error.stderr or str(error)).strip()}") from error


def matugen_colors(image_path):
    executable = shutil.which("matugen")
    if not executable:
        local = Path.home() / ".local/bin/matugen"
        if local.is_file():
            executable = str(local)
        else:
            raise RuntimeError("Install Matugen: cargo install matugen --version 4.2.0 "
                               "--locked --root ~/.local")
    result = run([
        executable, "image", str(image_path), "--config", str(DOTFILES / "matugen/config.toml"),
        "--type", "scheme-tonal-spot", "--mode", "dark", "--source-color-index", "0",
        "--contrast", "0", "--dry-run", "--quiet", "--json", "hex", "--old-json-output",
    ], capture_output=True)
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise RuntimeError("Matugen did not return valid JSON") from error


def hex_color(value):
    if not isinstance(value, str) or not re.fullmatch(r"#[0-9a-fA-F]{6}", value):
        raise ValueError(f"Invalid Matugen color: {value!r}")
    return value[1:].upper()


def build_scheme(data):
    try:
        colors = data["colors"]
        bases = [hex_color(colors[role]["dark"]) for role in NEUTRAL_ROLES]
        bases += [hex_color(data["palettes"]["neutral"][str(tone)]) for tone in (95, 99)]
        bases += [hex_color(colors[name]["dark"]) for name in SEMANTIC_COLORS]
        bases.append(hex_color(colors["primary"]["dark"]))
    except (KeyError, TypeError, ValueError) as error:
        raise RuntimeError(f"Unexpected Matugen palette format: {error}") from error
    validate_scheme(bases)
    return bases


def luminance(color):
    channels = [int(color[i:i + 2], 16) / 255 for i in (0, 2, 4)]
    linear = [c / 12.92 if c <= 0.04045 else ((c + 0.055) / 1.055) ** 2.4 for c in channels]
    return sum(c * weight for c, weight in zip(linear, (0.2126, 0.7152, 0.0722)))


def contrast(first, second):
    low, high = sorted((luminance(first), luminance(second)))
    return (high + 0.05) / (low + 0.05)


def validate_scheme(bases):
    # Check the actual pairs our templates use, before changing any files.
    pairs = [(5, 0, 7), (4, 2, 4.5), (5, 2, 4.5), (3, 0, 4.5)]
    pairs += [(i, 0, 4.5) for i in range(8, 16)]
    pairs += [(i, 1, 4.5) for i in range(8, 16)]
    for foreground, background, minimum in pairs:
        ratio = contrast(bases[foreground], bases[background])
        if ratio < minimum:
            raise RuntimeError(f"Insufficient contrast: base{foreground:02X}/base{background:02X} "
                               f"= {ratio:.2f}:1 (minimum {minimum}:1)")


def scheme_yaml(bases):
    lines = ['scheme: "Wallpaper"', 'author: "Matugen / Material You tonal spot"']
    lines += [f'base{i:02X}: "{color}"' for i, color in enumerate(bases)]
    return "\n".join(lines) + "\n"


def write_scheme(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    # Keep the old scheme intact if writing is interrupted.
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as handle:
        temporary = Path(handle.name)
        try:
            handle.write(content)
            handle.flush()
            os.replace(temporary, path)
        finally:
            temporary.unlink(missing_ok=True)


def apply_scheme():
    run(["flavours", "--config", str(DOTFILES / "flavours/config.toml"), "apply", "wallpaper"])
    run([sys.executable, str(DOTFILES / "scripts/apply-vscode-theme")])


def set_wallpaper(image_path):
    # argv avoids interpolating filenames into AppleScript source.
    run(["osascript", "-", str(image_path)], input='''on run argv
  set wallpaperFile to POSIX file (item 1 of argv)
  tell application "System Events"
    repeat with desktopItem in desktops
      set picture of desktopItem to wallpaperFile
    end repeat
  end tell
end run
''', capture_output=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("image", nargs="?", type=Path,
                        default=DOTFILES / "wallpaper/rei-plush-wallpaper.png")
    parser.add_argument("--output", type=Path, default=SCHEME_FILE, help="Base16 YAML destination")
    parser.add_argument("--stdout", action="store_true", help="Preview YAML without writing or applying")
    parser.add_argument("--apply", action="store_true", help="Apply the palette with flavours")
    parser.add_argument("--set-wallpaper", action="store_true", help="Also set every macOS desktop")
    args = parser.parse_args()
    if args.stdout and (args.apply or args.set_wallpaper):
        parser.error("--stdout cannot be combined with --apply or --set-wallpaper")
    if args.set_wallpaper and not args.apply:
        parser.error("--set-wallpaper requires --apply")
    if args.apply and args.output != SCHEME_FILE:
        parser.error("--apply requires the default scheme output path")
    image_path = args.image.expanduser().resolve()
    if not image_path.is_file():
        parser.error(f"Image not found: {image_path}")
    try:
        bases = build_scheme(matugen_colors(image_path))
        content = scheme_yaml(bases)
        if args.stdout:
            print(content, end="")
            return
        write_scheme(args.output.expanduser(), content)
        print(f"Scheme written: {args.output}", flush=True)
        if args.apply:
            apply_scheme()
        if args.set_wallpaper:
            set_wallpaper(image_path)
            print(f"Wallpaper applied: {image_path}")
        print(f"Text/background contrast: {contrast(bases[5], bases[0]):.2f}:1")
    except (RuntimeError, OSError) as error:
        print(f"Error: {error}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
