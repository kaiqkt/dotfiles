#!/bin/sh
set -eu

spaces=$(yabai -m query --spaces)
rules=$(yabai -m rule --list)
displays=$(yabai -m query --displays)
display_count=$(printf '%s\n' "$displays" | jq 'length')
case "$display_count" in
  1) last_display=1 ;;
  2) last_display=2 ;;
  *) echo "Expected one or two displays; found $display_count" >&2; exit 1 ;;
esac
changed=false

add_rule() {
  label=$1
  app=$2
  space=$3
  display=$4

  if printf '%s\n' "$rules" | jq -e --arg label "$label" --arg app "$app" --argjson index "$space" \
    'any(.[]; .label == $label and .app == $app and .space == $index)' >/dev/null &&
    printf '%s\n' "$spaces" | jq -e --argjson index "$space" --argjson display "$display" \
      'any(.[]; .index == $index and .display == $display)' >/dev/null; then
    return
  fi

  if printf '%s\n' "$rules" | jq -e --arg label "$label" 'any(.[]; .label == $label)' >/dev/null; then
    yabai -m rule --remove "$label"
    changed=true
  fi

  if ! printf '%s\n' "$spaces" | jq -e --argjson index "$space" --argjson display "$display" \
    'any(.[]; .index == $index and .display == $display)' >/dev/null; then
    return
  fi

  yabai -m rule --add "label=$label" "app=$app" "space=$space"
  changed=true
}

# Register app assignments once their native Spaces exist.
add_rule dotfiles_browsers '^(Safari|Google Chrome)$' 1 1
add_rule dotfiles_terminals '^(Terminal|kitty)$' 2 1
add_rule dotfiles_claude '^Claude$' 8 "$last_display"
add_rule dotfiles_spotify '^Spotify$' 9 "$last_display"

if [ "$changed" = true ]; then
  yabai -m rule --apply
fi
