#!/bin/sh

# Opacity and space management need yabai's scripting addition. The sudoers
# entry documented in README.md lets this run at login without a password.
if sudo -n yabai --load-sa 2>/dev/null; then
  yabai -m signal --add event=dock_did_restart action="sudo -n yabai --load-sa"
fi

yabai -m config layout                       bsp
yabai -m config window_placement             second_child
yabai -m config split_ratio                  0.5
yabai -m config auto_balance                 off
yabai -m config top_padding                  56
yabai -m config bottom_padding                8
yabai -m config left_padding                  8
yabai -m config right_padding                 8
yabai -m config window_gap                    8
yabai -m config mouse_follows_focus          off
yabai -m config focus_follows_mouse          off

# Apply the same opacity to focused and unfocused windows.
yabai -m config window_opacity                on
yabai -m config window_opacity_duration       0.0
yabai -m config active_window_opacity        0.98
yabai -m config normal_window_opacity        0.98

# Keep Sketchybar's focused Space and app icons up to date.
for event in space_changed display_changed window_created window_destroyed window_moved window_minimized window_deminimized application_activated; do
  yabai -m signal --add event="$event" action='sketchybar --trigger yabai_workspace_change'
done
for event in space_created space_destroyed display_added display_removed; do
  yabai -m signal --add event="$event" action='sketchybar --reload'
done
for event in space_created space_destroyed display_added display_removed; do
  yabai -m signal --add event="$event" action='~/.config/yabai/scripts/sync-rules'
done

# If Sketchybar starts first at login, rebuild its Space items once yabai is ready.
(
  attempt=0
  until yabai -m query --spaces >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    [ "$attempt" -ge 20 ] && exit 0
    sleep 1
  done
  "$HOME/.config/yabai/scripts/sync-rules"
  sketchybar --reload >/dev/null 2>&1
) &
