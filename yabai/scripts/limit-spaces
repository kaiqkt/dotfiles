#!/bin/sh
set -eu

max_spaces=10

spaces=$(yabai -m query --spaces)
printf '%s\n' "$spaces" | jq -r --argjson max "$max_spaces" '
  [.[] | select(.index > $max and (.windows | length) == 0 and
                ."is-native-fullscreen" == false) | .index] | sort | reverse[]
' | while IFS= read -r index; do
  current=$(yabai -m query --spaces --space "$index") || continue
  if printf '%s\n' "$current" | jq -e --argjson max "$max_spaces" '
    .index > $max and (.windows | length) == 0 and
    ."is-native-fullscreen" == false
  ' >/dev/null; then
    yabai -m space "$index" --destroy
  fi
done
