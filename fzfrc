--tmux 90%,90%
--multi
--bind='ctrl-o:become($EDITOR {})'
--bind 'ctrl-/:toggle-preview'
--bind 'ctrl-d:preview-half-page-down'
--bind 'ctrl-u:preview-half-page-up'
--preview 'fzf-preview.sh {}'
--padding=0%
--layout=reverse
--border-label=''
--info=hidden
--prompt='▶ '
--pointer='▶'
--marker=''
--padding 0,1
--margin 0,0
--border
--style=full
--no-scrollbar
--bind 'focus:transform-preview-label:[[ -n {} ]] && printf \" %s \" {}'
--color=dark
--color 'bg:#181c20,fg:#e0e2e8,preview-bg:#181c20,preview-fg:#e0e2e8'
--color 'input-fg:#e0e2e8,current-fg:#e0e2e8,hl:#9ccbfb,prompt:#9ccbfb'
--color 'border:#323539,label:#8c9199'
--color 'input-border:#8c9199,input-label:#c2c7cf'
--color 'preview-border:#8c9199,preview-label:#c2c7cf'
--color 'list-border:#8c9199,list-label:#c2c7cf'
--color 'gutter:#272a2f'
--color 'current-bg:#272a2f'
--color 'current-hl:#9ccbfb'
--color 'list-fg:#c2c7cf'
--color 'pointer:#9ccbfb'
--color 'marker:#9ccbfb'